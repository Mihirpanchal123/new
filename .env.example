# ─── Server ──────────────────────────────────────────────────────────────
# Port the combined Next.js + Socket.IO server listens on.
PORT=3000
# Interface to bind (use 0.0.0.0 in containers).
HOSTNAME=localhost

# ─── Security ────────────────────────────────────────────────────────────
# REQUIRED in production. Signs guest session cookies (HMAC-SHA256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Enables /admin. Leave empty to disable the admin area entirely.
ADMIN_TOKEN=
# Show secret answers in the admin inspector. Ignored when NODE_ENV=production.
ADMIN_SHOW_SECRETS=false

# ─── Persistence (no database) ───────────────────────────────────────────
# Profiles, match history and leaderboards are kept in memory and
# snapshotted to this JSON file so they survive restarts.
# Set PERSISTENCE=memory to disable the snapshot entirely.
PERSISTENCE=file
DATA_FILE=.data/word-duel.json

# ─── Realtime ────────────────────────────────────────────────────────────
# Leave empty to connect to the same origin (default, single server).
# Set when the realtime server runs separately from the web app (e.g. web on Vercel).
NEXT_PUBLIC_REALTIME_URL=
# Comma-separated list of allowed origins for the Socket.IO server when cross-origin.
REALTIME_CORS_ORIGINS=
# ICE servers for in-game voice chat, as JSON (RTCIceServer[]). Defaults to a public STUN
# server, which covers most home networks; add a TURN server for strict NATs / corporate networks.
# e.g. [{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
NEXT_PUBLIC_ICE_SERVERS=

# ─── Public site ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Analytics ───────────────────────────────────────────────────────────
# "console" logs events, "none" disables. Plug other providers in lib/analytics.
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
